# C++ AI Chat Server - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ========== AI API 配置 ==========
# 国家超算互联网 API Key
# 获取地址: https://www.scnet.cn
AI_API_KEY=your_api_key_here

# API URL
AI_API_URL=https://api.scnet.cn/api/llm/v1/chat/completions

# AI 模型
AI_MODEL=MiniMax-M2.5

# ========== 服务器配置 ==========
# 服务器端口
SERVER_PORT=8080

# ========== 数据库配置 ==========
# 数据库文件路径（Docker 内）
DB_PATH=/app/data/chat.db
